# The explicitly trusted domain for the application (e.g. https://photos.mydomain.com)
# Used for CORS validation, setting secure auth cookies, and generating share links.
APP_DOMAIN=http://localhost:8000
PUBLIC_APP_DOMAIN=http://localhost:8000

# Cloudflare Turnstile (TURNSTILE_SITEKEY is the public site key; it is served to
# the frontend at runtime — never baked into any image. TURNSTILE_SECRET stays
# server-only for siteverify.)
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Secrets used to sign auth JWTs and cookies.
# Generate fresh ones with:
#   openssl rand -hex 48
# These are REQUIRED for production. Without them the app falls back to
# hardcoded defaults that are public in the source, allowing JWT/cookie forgery.
# Changing JWT_SECRET invalidates all existing sessions (users must re-login).
JWT_SECRET=<generate with: openssl rand -hex 48>
COOKIE_SECRET=<generate with: openssl rand -hex 48>

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=hellomyphotos
DB_PASS=hellomyphotos_secret
DB_NAME=hellomyphotos

# Postgres Init (For docker-compose postgres container)
POSTGRES_USER=hellomyphotos
POSTGRES_PASSWORD=hellomyphotos_secret
POSTGRES_DB=hellomyphotos

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Machine Learning
IMMICH_ML_URL=http://machine-learning:3003
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_WORKER_TIMEOUT=120

# Storage
MEDIA_ROOT=/app/media
CACHE_ROOT=/app/cache
