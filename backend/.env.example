# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=hellomyphotos
DB_PASS=hellomyphotos_secret
DB_NAME=hellomyphotos

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Machine Learning Service URL
IMMICH_ML_URL=http://localhost:3003



# Server Port
PORT=3000

# Cloudflare Turnstile (TURNSTILE_SITEKEY is public; served to frontend at runtime.
# TURNSTILE_SECRET stays server-only for siteverify.)
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Secrets used to sign auth JWTs and cookies.
# Generate fresh ones with:
#   openssl rand -hex 48
# These are REQUIRED for production. Without them the app falls back to
# hardcoded defaults that are public in the source, allowing JWT/cookie forgery.
# Changing JWT_SECRET invalidates all existing sessions (users must re-login).
JWT_SECRET=
COOKIE_SECRET=

# Worker Limits & Concurrency Tuning
# Optionally override individual queue concurrency:
SCANNER_CONCURRENCY=1
METADATA_CONCURRENCY=2
THUMBNAIL_CONCURRENCY=1
VIDEO_CONCURRENCY=1
SMART_SEARCH_CONCURRENCY=1
FACE_DETECTION_CONCURRENCY=1
FACE_THUMBNAIL_CONCURRENCY=2
FACIAL_RECOGNITION_CONCURRENCY=1
MAX_CPU_CORES=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=
