	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-plugin-pwa": "^2.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.53.0",
		"@tanstack/svelte-virtual": "^3.13.39",
		"blurhash": "^2.0.5",
		"devalue": "^6.0.2",
		"panzoom": "^9.4.4"
	},
	"overrides": {
		"typescript": "$typescript",
