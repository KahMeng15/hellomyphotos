FROM node:22-alpine

WORKDIR /app
COPY package*.json ./
# npm ci can omit Rollup's platform-specific optional package on Alpine ARM64.
# Re-resolve optional dependencies for the container's actual architecture.
RUN rm -f package-lock.json && npm install --legacy-peer-deps
COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]
